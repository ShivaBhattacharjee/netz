{
  "name": "catalogforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "start:render": "pnpm db:migrate && concurrently --kill-others --names web,worker \"next start\" \"pnpm worker\"",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@next/env": "15.5.28",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.12",
    "bullmq": "^6.3.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.60.0",
    "motion": "^14.4.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.1.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.1.0",
    "recharts": "3.8.0",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
